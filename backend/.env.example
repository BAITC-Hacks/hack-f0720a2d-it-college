# Paths are resolved relative to the backend directory.
DATABASE_PATH=data/backend.sqlite3
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# mock works offline and is explicitly marked in API responses.
# Set openai to enable real AI analysis. No silent fallback on provider errors.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=30
