DATABASE_URL=sqlite:///./ai_sana.db
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
# auto: OpenAI when a key is configured; otherwise local templates.
# openai: require a key. stub: explicitly work offline.
AI_PROVIDER=auto
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=4000
# Optional separate compatible provider; never inherit OPENAI_API_KEY.
# Enable with AI_PROVIDER=compatible or explicitly save a personal connection.
AI_BASE_URL=http://127.0.0.1:1234/v1
# Empty = first available text model. The UI can select a model per business user.
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT=180
AI_MAX_TOKENS=4096
AI_RESPONSE_FORMAT=auto
